<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baomibing.authority.mapper.SysTenantMenuMapper">


	<!-- 展示所有菜单及为分配权限-只加载需要授权的 -->
	<select id="listAllMenusForGrant" resultType="com.baomibing.authority.entity.SysMenuTenant">
		SELECT
			m.id,m.menu_name,m.parent_id
		FROM
			sys_menu_tenant m
			INNER JOIN sys_tenant_menu tm ON (tm.menu_id = m.id)
		WHERE  tm.tenant_id = #{tenantId,jdbcType=CHAR}
		GROUP BY m.id
	</select>
</mapper>
