<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baomibing.authority.mapper.SysMenuTenantMapper">

    
    <!-- 根据菜单ID列表获取资源菜单列表-关联资源 -->
    <select id="listAllResourceMenusByIds" resultType="com.baomibing.authority.entity.SysMenuTenant">
    	SELECT DISTINCT sm.id, sm.redirect, sm.be_hidden, 
         sm.menu_name, sm.priority, sm.icon, sm.parent_id, ra.req_url
		FROM sys_menu_tenant sm
		INNER JOIN sys_resource_api_tenant ra ON sm.id = ra.resource_id AND ra.resource_type = 'MENU'
		<where>
		<if test="menuIds != null and menuIds.size() > 0">
 			AND sm.id in 
			<foreach collection="menuIds" index="index" item="item" open="(" separator="," close=")">
	            #{item}       
	        </foreach>
	    </if>
	    </where> 
        ORDER BY sm.parent_id, sm.priority ASC
    </select>
    
    <!-- 递归获取子节点对应的所有父节点,注意get_parent_list为mysql对应的函数，具体代码：
    DELIMITER //
		create function get_parent_list(nodeId varchar(50)) 
		returns varchar (2000)
		DETERMINISTIC
		BEGIN 
		   DECLARE fid varchar(100) default ''; 
		   DECLARE str varchar(2000) default nodeId;
		 
		    WHILE nodeId is not null  do 
		        SET fid =(SELECT parent_id FROM sys_menu WHERE id = nodeId); 
		        IF fid is not null THEN 
		            SET str = concat(str, ',', fid); 
		            SET nodeId = fid; 
		        ELSE 
		            SET nodeId = fid; 
		        END IF; 
		    END WHILE; 
		   return str;
		END //
		DELIMITER ;
     -->
    <select id="listAllParentByIds" resultType="java.lang.String">
<!--    	SELECT get_parent_list(t.id) FROM sys_menu t WHERE t.id in  -->
<!--			<foreach collection="menuIds" index="index" item="item" open="(" separator="," close=")">-->
<!--	            #{item}       -->
<!--	        </foreach>-->
		SELECT CONCAT_WS(',',m1.id,m1.parent_id,m2.parent_id,m3.parent_id,m4.parent_id,m5.parent_id,m6.parent_id) as parent_id
		FROM sys_menu_tenant m1
		LEFT JOIN sys_menu_tenant m2 on m2.id = m1.parent_id
		LEFT JOIN sys_menu_tenant m3 on m3.id = m2.parent_id
		LEFT JOIN sys_menu_tenant m4 on m4.id = m3.parent_id
		LEFT JOIN sys_menu_tenant m5 on m5.id = m4.parent_id
		LEFT JOIN sys_menu_tenant m6 on m6.id = m5.parent_id
		WHERE  m1.id in
		<foreach collection="menuIds" index="index" item="item" open="(" separator="," close=")">
			#{item}
		</foreach>
    </select>

	<!-- 展示所有菜单及为分配权限-只加载需要授权的 -->
	<select id="listAllMenusForGrant" resultType="com.baomibing.authority.entity.SysMenuTenant">
		SELECT
			m.id,m.menu_name,m.parent_id
		FROM
			sys_menu_tenant m
				INNER JOIN sys_resource_api_tenant ra ON (ra.resource_id = m.id AND ra.resource_type = 'MENU')
		WHERE  m.be_unauth = 0
		GROUP BY m.id
	</select>
</mapper>
