<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baomibing.authority.mapper.SysUsetUserEntrustMapper">

    
    <!-- 根据用户ID和业务权限ID获取用户委托的用户ID列表 -->
    <select id="listEntrustUserCodesByUsetAndPerm" resultType="java.lang.String">
        SELECT ur.user_no
		FROM sys_uset u
		INNER JOIN sys_uset_user_entrust ue ON ue.uset_id = u.id
	    INNER JOIN sys_user ur ON ur.id = ue.user_entrust_id
		WHERE  ue.perm_id = #{permId,jdbcType=CHAR} AND ue.uset_id IN
        <foreach collection="usetIds" index="index" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <select id="listEntrustUserIdsByUsetAndPerm" resultType="java.lang.String">
        SELECT ur.id
        FROM sys_uset u
        INNER JOIN sys_uset_user_entrust ue ON ue.uset_id = u.id
        INNER JOIN sys_user ur ON ur.id = ue.user_entrust_id
        WHERE  ue.perm_id = #{permId,jdbcType=CHAR} AND ue.uset_id IN
        <foreach collection="usetIds" index="index" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
    
    <!-- 根据用户ID和业务权限ID获取用户委托的用户名列表 -->
    <!--<select id="listEntrustUserCodesByGroupAndUserAndPerm" resultType="java.lang.String">
        SELECT u.user_no
		FROM sys_user u
		INNER JOIN sys_user_entrust ue ON ue.user_entrust_id = u.id
		WHERE ue.user_id = #{userId, jdbcType=CHAR} and ue.perm_id = #{permId,jdbcType=CHAR} and ue.org_id = #{orgId,jdbcType=CHAR}
    </select>-->
    
    <!-- 根据用户ID及业务权限ID删除该用户该功能委托的用户 -->
    <delete id="deleteByUsetAndPerm">
    	DELETE FROM sys_uset_user_entrust  WHERE uset_id = #{usetId, jdbcType=CHAR} AND perm_id = #{permId, jdbcType=CHAR}
    </delete>
</mapper>
