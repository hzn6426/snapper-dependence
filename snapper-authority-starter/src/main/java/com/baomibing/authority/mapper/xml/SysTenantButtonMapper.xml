<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baomibing.authority.mapper.SysTenantButtonMapper">


	<!-- 展示所有菜单及为分配权限-只加载需要授权的 -->
	<select id="listByMenuForGrant" resultType="com.baomibing.authority.entity.SysButtonTenant">
		SELECT
			b.id, b.button_name,b.menu_id,b.sub_menu
		FROM
			sys_button_tenant b
			INNER JOIN sys_tenant_button tb ON (tb.button_id = b.id)
		WHERE  tb.tenant_id = #{tenantId,jdbcType=CHAR} and b.menu_id = #{menuId,jdbcType=CHAR} and b.be_unauth = 0
	</select>

	<select id="listAllButtonsForGrant" resultType="com.baomibing.authority.entity.SysButtonTenant">
		SELECT
			b.id, b.button_name,b.menu_id,b.sub_menu
		FROM
			sys_button_tenant b
				INNER JOIN sys_tenant_button tb ON (tb.button_id = b.id)
		WHERE  tb.tenant_id = #{tenantId,jdbcType=CHAR} and b.be_unauth = 0
	</select>
</mapper>
